
# Animal Tracker - Environment Variables

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-super-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/animal_tracker

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Security
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_DEFAULT=200 per day, 50 per hour

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/animal-tracker/app.log

# External Services (if needed)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# Mobile App Configuration
MOBILE_API_URL=http://localhost:5000

# Hardware Configuration (for ESP32 devices)
# GPS_UPDATE_INTERVAL=300
# BLUETOOTH_SCAN_INTERVAL=30

